NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Required by the production server to encrypt its HttpOnly session cookie.
# Replace with a distinct high-entropy secret; never reuse the backend JWT keys.
LUNAS_SESSION_SECRET=replace_with_a_distinct_high_entropy_secret

# Cloudflare Turnstile public site key for the web login CAPTCHA. Use a real,
# hostname-restricted key in production. This official dummy key is only for
# local development and automated QA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
