# Private runtime URL used only by the Next.js server/BFF. In Compose this is
# http://backend:5000/api/v1; for host-based development it is localhost.
LUNAS_API_URL=http://localhost:5000/api/v1

# Browser-facing build-time URL. Current authenticated web requests use the
# BFF, but keep this separate for explicitly public browser integrations.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Required by the production server to encrypt its HttpOnly session cookie.
# Replace with a distinct high-entropy secret; never reuse the backend JWT keys.
LUNAS_SESSION_SECRET=replace_with_a_distinct_high_entropy_secret

# Cloudflare Turnstile public site key for the web login CAPTCHA. Use a real,
# hostname-restricted key in production. This official dummy key is only for
# local development and automated QA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Local development only. Set to true temporarily when Turnstile is unavailable.
# Never enable this in production.
NEXT_PUBLIC_LUNAS_DISABLE_LOGIN_CAPTCHA=false
LUNAS_DISABLE_LOGIN_CAPTCHA=false
