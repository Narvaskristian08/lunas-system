# LUNAS AI Service Configuration

# Service Configuration
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
DEBUG=False

# Model Configuration
MODEL_ROAD_DAMAGE=yolov8n.pt
MODEL_CRACK_DETECTION=yolov8n-seg.pt

# Detection Thresholds
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
MAX_DETECTIONS=50

# Image Processing
MAX_IMAGE_SIZE=1920
IMAGE_QUALITY=85
SUPPORTED_FORMATS=jpg,jpeg,png,webp

# Performance
BATCH_SIZE=1
DEVICE=cpu                   # cpu, cuda, mps (for M1)
NUM_WORKERS=4
ENABLE_HALF_PRECISION=False  # True for GPU only

# Cache & Storage
MODEL_CACHE_DIR=./models/cache
INFERENCE_CACHE_DIR=./cache/inference
ENABLE_MODEL_CACHE=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/lunas_ai.log
ENABLE_METRICS=False

# Security
MAX_REQUEST_SIZE=10485760    # 10MB
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
API_KEY=your_api_key_here    # Optional: for production

# Fine-tuning Configuration (for future use)
DATASET_PATH=./datasets/rdd2022
TRAINING_OUTPUT=./models/trained
EPOCHS=100
BATCH_SIZE_TRAIN=16
LEARNING_RATE=0.001
