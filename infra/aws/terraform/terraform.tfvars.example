enable_aws_resources = false
enable_ec2_resources = false
enable_ai_resources   = false
aws_region           = "ap-southeast-1"
project_name         = "lunas"
environment          = "production"

# S3 bucket names are globally unique. Replace this before enabling resources.
bucket_prefix = "replace-with-your-account-suffix-lunas-"

# Pin reviewed AMIs before a production apply. The default selects the latest
# Amazon Linux 2023 AMI, but it does not install MongoDB or the application.
# Both instances default to t3.micro and CPU credits are capped at standard to
# avoid the extra charges that T3 Unlimited can create under sustained load.
app_ami_id = ""
db_ami_id  = ""
ai_ami_id  = ""

# YOLO/privacy inference needs more memory than the t3.micro app host.
# Stop this instance after validation; t3.small is not guaranteed to be free.
ai_instance_type = "t3.small"

# Prefer Session Manager. Leave this null unless a reviewed emergency process
# requires an EC2 key pair.
ssh_key_name = null
