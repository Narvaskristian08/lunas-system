      "program": "${workspaceFolder}/lunas_mobile/lib/main.dart",
      "cwd": "${workspaceFolder}/lunas_mobile",
      "toolArgs": [
        "--web-port",
        "3000",
        "--dart-define=LUNAS_API_BASE_URL=http://localhost:5000/api/v1"
      ]
    }
  ]
}
