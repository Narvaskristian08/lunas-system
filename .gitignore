# YOLO Training Artifacts (257MB - exclude from repo)
# Training outputs are stored here when running from project root
runs/

# Root deployment environment. Keep actual AWS/Compose credentials out of Git.
/.env
/.env.*
!/.env.example
!/.env.local.example

# OS Files
.DS_Store
.vscode/
/docker-local-build.log
/docker-local-core.log

# Local Terraform provider cache and state. Store state remotely before a
# shared or production deployment; never commit credentials or local state.
/infra/aws/terraform/.terraform/
/infra/aws/terraform/terraform.tfstate*

# Local database snapshots before fixture replacement.
/.local-backups/
