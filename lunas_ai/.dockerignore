# Docker ignore file

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environment
venv/
.venv/
ENV/
env/

# Environment
.env
.env.local

# Model weights used by the configured inference routes are bundled in the
# image. Do not bundle model caches, datasets, or training outputs.
models/cache/

# Datasets
datasets/
data/
*.zip
*.tar
*.tar.gz

# Training outputs
runs/
weights/

# Logs
logs/
*.log
src/models/*.zip

# Cache
cache/
*.cache

# Testing
.pytest_cache/
**/__pycache__/
.coverage

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Git
.git/
.gitignore

# Documentation
*.md
docs/

# CI/CD
.github/
.gitlab-ci.yml

# Temporary
tmp/
temp/
*.tmp
