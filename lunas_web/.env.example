NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
LUNAS_API_URL=http://localhost:5000/api/v1

# Encrypts server-managed sessions and pending privileged MFA challenges.
# Use one unique, high-entropy value per deployed environment.
LUNAS_SESSION_SECRET=replace-with-a-long-random-secret

# Cloudflare Turnstile public site key for the web login CAPTCHA. Use a real,
# hostname-restricted key in production. This official dummy key is only for
# local development and automated QA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
