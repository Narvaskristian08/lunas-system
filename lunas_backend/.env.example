# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/lunas_db
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/lunas_db

# Local presentation seed (optional). The manual seed command refuses
# production, non-local MongoDB URI hosts, and any database except `lunas_demo`.
# Leave this false unless you deliberately run the local demo seed.
ALLOW_DEMO_SEED=false
# Optional local-only password override for the seeded demo accounts.
# Empty uses the documented local demo password.
DEMO_SEED_PASSWORD=
# If using this repository's `docker compose up -d mongodb`, use this local
# demo database URI instead of the unauthenticated example above:
# MONGODB_URI=mongodb://admin:admin123@localhost:27017/lunas_demo?authSource=admin

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRE=30d
MAX_REFRESH_TOKENS_PER_USER=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Cloudflare Turnstile validation for web login. Use the official dummy secret
# below only for local development/QA and a real hostname-restricted secret in
# production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1,dummy-key-response
TURNSTILE_TIMEOUT_MS=8000

# Email OTP challenge required before mobile citizen registration receives a
# session. The delivery URL is an approved provider webhook; it receives the
# recipient and one-time code. Keep REGISTRATION_MFA_EXPOSE_CODE false except
# in isolated local QA.
REGISTRATION_MFA_SECRET=replace_with_a_distinct_high_entropy_secret
REGISTRATION_MFA_EXPIRE_MINUTES=10
REGISTRATION_MFA_RESEND_SECONDS=60
REGISTRATION_MFA_DELIVERY_URL=https://your-approved-email-provider.example/registration-mfa
REGISTRATION_MFA_DELIVERY_TOKEN=replace_with_the_provider_webhook_token
REGISTRATION_MFA_DELIVERY_TIMEOUT_MS=10000
REGISTRATION_MFA_EXPOSE_CODE=false

# Email OTP required after password verification for admin, city engineer,
# barangay official, and utility-provider accounts. Delivery variables fall
# back to the registration MFA provider when omitted.
PRIVILEGED_MFA_SECRET=replace_with_a_distinct_high_entropy_secret
PRIVILEGED_MFA_EXPIRE_MINUTES=10
PRIVILEGED_MFA_RESEND_SECONDS=60
PRIVILEGED_MFA_DELIVERY_URL=https://your-approved-email-provider.example/privileged-login-mfa
PRIVILEGED_MFA_DELIVERY_TOKEN=replace_with_the_provider_webhook_token
PRIVILEGED_MFA_DELIVERY_TIMEOUT_MS=10000
PRIVILEGED_MFA_EXPOSE_CODE=false

# Password reset delivery (optional). Configure both variables to send reset
# links through an approved email/provider webhook. No email is fabricated
# when this integration is absent.
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_APP_URL=https://your-app.example/reset-password
PASSWORD_RESET_DELIVERY_URL=https://your-approved-email-provider.example/password-reset
PASSWORD_RESET_DELIVERY_TIMEOUT_MS=10000

# Supabase Configuration (for storage and real-time)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_or_service_role_key
SUPABASE_STORAGE_BUCKET=lunas-storage
# Keep citizen evidence private unless this bucket has been deliberately made
# public. Private evidence is exposed through short-lived signed URLs.
SUPABASE_STORAGE_PUBLIC=false
EVIDENCE_SIGNED_URL_EXPIRE_SECONDS=3600

# OneSignal Configuration (for push notifications)
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key
ONESIGNAL_USER_AUTH_KEY=your_onesignal_user_auth_key

# Google Maps Android setup
#
# The Android Maps key is configured in the Flutter mobile project, not in
# this backend .env file. Follow these steps for a local Android phone or
# emulator:
#
# 1. Open https://console.cloud.google.com/ and select the LUNAS project.
# 2. Go to APIs & Services > Library and enable "Maps SDK for Android".
# 3. Go to APIs & Services > Credentials > Create credentials > API key.
# 4. Open the new key and set Application restrictions to "Android apps".
# 5. Add this Android package name:
#       com.example.lunas_mobile
# 6. Add the SHA-1 fingerprint for the keystore used to run the app.
#    For a debug build, get it from Android Studio's Gradle signingReport
#    or the local debug keystore. Use the release SHA-1 for release builds.
# 7. Under API restrictions, allow only "Maps SDK for Android".
# 8. On the developer's computer, store the key outside the repository at:
#       %USERPROFILE%\.gradle\gradle.properties
#    Add:
#       MAPS_API_KEY=your_restricted_android_key
# 9. Run the mobile app with the backend URL reachable from the phone:
#       flutter run -d <phone-id> --dart-define=LUNAS_API_BASE_URL=http://<PC-LAN-IP>:5000/api/v1
#    The phone and computer must be on the same Wi-Fi network. Do not use
#    localhost from the phone; use the computer's IPv4 address instead.
#
# Never commit a real Google Maps key, Supabase key, or service-role/secret key.
# This backend variable is retained for older integrations; the Flutter
# Android build reads MAPS_API_KEY from Gradle properties or the environment.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# SLA Configuration (in hours)
SLA_CRITICAL=48
SLA_HIGH=72
SLA_MEDIUM=168
SLA_LOW=336
# Work-order approaching-deadline warning threshold. The backend, not web or
# mobile clients, determines this state.
SLA_APPROACHING_THRESHOLD_HOURS=24
# The 75% checker can be invoked by an external scheduler. Set this true only
# to enable the in-process cron monitor in the API process.
SLA_AUTOMATION_ENABLED=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/webp
ALLOWED_IMAGE_FORMATS=jpeg,png,webp
MIN_IMAGE_WIDTH=320
MIN_IMAGE_HEIGHT=240
EVIDENCE_MAX_WIDTH=1920
EVIDENCE_WEBP_QUALITY=82

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# AI Service Configuration
AI_SERVICE_URL=http://localhost:5001
AI_SERVICE_TIMEOUT=30000
AI_SERVICE_ENABLED=true
# The backend sends uploaded evidence to the AI service when true. Reports
# always remain subject to official manual review, including AI failures.
AI_EVIDENCE_ANALYSIS_ENABLED=true

# Conservative possible-duplicate candidate detection. This never changes a
# report's submitted status automatically.
DUPLICATE_WINDOW_HOURS=72
DUPLICATE_RADIUS_METERS=100
