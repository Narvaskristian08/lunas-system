# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/lunas_db
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/lunas_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRE=30d
MAX_REFRESH_TOKENS_PER_USER=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Password reset delivery (optional). Configure both variables to send reset
# links through an approved email/provider webhook. No email is fabricated
# when this integration is absent.
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_APP_URL=https://your-app.example/reset-password
PASSWORD_RESET_DELIVERY_URL=https://your-approved-email-provider.example/password-reset
PASSWORD_RESET_DELIVERY_TIMEOUT_MS=10000

# Supabase Configuration (for storage and real-time)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=lunas-storage
# Keep citizen evidence private unless this bucket has been deliberately made
# public. Private evidence is exposed through short-lived signed URLs.
SUPABASE_STORAGE_PUBLIC=false
EVIDENCE_SIGNED_URL_EXPIRE_SECONDS=3600

# OneSignal Configuration (for push notifications)
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key
ONESIGNAL_USER_AUTH_KEY=your_onesignal_user_auth_key

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# SLA Configuration (in hours)
SLA_CRITICAL=48
SLA_HIGH=72
SLA_MEDIUM=168
SLA_LOW=336
# The 50% milestone initializes/display SLA deadlines. Keep the later
# reminder/escalation cron disabled until its operational policy is approved.
SLA_AUTOMATION_ENABLED=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg
ALLOWED_IMAGE_FORMATS=jpeg,png
MIN_IMAGE_WIDTH=320
MIN_IMAGE_HEIGHT=240
EVIDENCE_MAX_WIDTH=1920
EVIDENCE_JPEG_QUALITY=82

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# AI Service Configuration
AI_SERVICE_URL=http://localhost:5001
AI_SERVICE_TIMEOUT=30000
AI_SERVICE_ENABLED=true
# Enable only when the configured AI service has a real, tested model. Manual
# category selection remains the fallback when this is false/unavailable.
AI_EVIDENCE_ANALYSIS_ENABLED=false

# Conservative possible-duplicate candidate detection. This never changes a
# report's submitted status automatically.
DUPLICATE_WINDOW_HOURS=72
DUPLICATE_RADIUS_METERS=100
