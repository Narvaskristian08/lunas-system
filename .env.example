# LUNAS System Environment Configuration
# Copy this file to .env and fill in your credentials

# ========================================
# JWT Secrets (CHANGE THESE!)
# ========================================
JWT_SECRET=your_super_secret_jwt_key_change_this_minimum_32_characters
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_minimum_32_characters

# ========================================
# Supabase Configuration
# ========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=lunas-storage

# ========================================
# OneSignal Configuration
# ========================================
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key
ONESIGNAL_USER_AUTH_KEY=your_onesignal_user_auth_key

# ========================================
# Google Maps API (Optional)
# ========================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ========================================
# Database Configuration (Docker)
# ========================================
# MongoDB credentials are configured in docker-compose.yml
# Default: admin / admin123
# Database: lunas_db

# ========================================
# Notes
# ========================================
# 1. NEVER commit this file to version control
# 2. Generate strong JWT secrets (minimum 32 characters)
# 3. Keep Supabase service_role key secret
# 4. Keep OneSignal REST API key secret
# 5. For production, use environment-specific values
