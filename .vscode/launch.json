{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open qa_test_gui.html",
      "file": "/Users/deb/Desktop/lunas-system/lunas_ai/qa_test_gui.html"
    },
    {
      "name": "LUNAS Web (Chrome :3000)",
      "request": "launch",
      "type": "dart",
