# LUNAS System Environment Configuration
# Copy this file to .env and fill in your credentials

# ========================================
# JWT Secrets (CHANGE THESE!)
# ========================================
JWT_SECRET=your_super_secret_jwt_key_change_this_minimum_32_characters
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_minimum_32_characters
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
MAX_REFRESH_TOKENS_PER_USER=5

# Required by the Next.js BFF to encrypt its HttpOnly session cookie. Generate
# an unrelated high-entropy value of at least 32 characters. The production
# web server rejects missing, short, or placeholder values.
LUNAS_SESSION_SECRET=replace_with_a_distinct_high_entropy_session_secret

# ========================================
# Web Login CAPTCHA (Cloudflare Turnstile)
# ========================================
# The values below are Cloudflare's public dummy keys for local testing only.
# Replace both with hostname-restricted production keys before deployment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1,dummy-key-response
TURNSTILE_TIMEOUT_MS=8000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Exact browser origins permitted to call the backend directly. The Next.js
# BFF uses server-to-server requests and does not require its Docker hostname
# in this list. Replace these with the public HTTPS origins in production.
CORS_ORIGIN=http://localhost:3000

# ========================================
# Mobile Registration Email MFA
# ========================================
REGISTRATION_MFA_SECRET=replace_with_a_distinct_high_entropy_secret
REGISTRATION_MFA_EXPIRE_MINUTES=10
REGISTRATION_MFA_RESEND_SECONDS=60
REGISTRATION_MFA_DELIVERY_URL=https://your-approved-email-provider.example/registration-mfa
REGISTRATION_MFA_DELIVERY_TOKEN=replace_with_the_provider_webhook_token
REGISTRATION_MFA_DELIVERY_TIMEOUT_MS=10000
REGISTRATION_MFA_EXPOSE_CODE=false

# Transactional email. Set EMAIL_PROVIDER=resend and provide the Resend API
# key/from address for staging or production. Keep the webhook values above
# for local provider-mock testing; never commit a real key.
EMAIL_PROVIDER=webhook
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com
EMAIL_FROM=
ACCOUNT_ACTIVATION_APP_URL=http://localhost:3000/activate-account
ACCOUNT_ACTIVATION_DELIVERY_URL=
ACCOUNT_ACTIVATION_DELIVERY_TOKEN=
ACCOUNT_ACTIVATION_DELIVERY_TIMEOUT_MS=10000
ACCOUNT_ACTIVATION_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_APP_URL=http://localhost:3000/reset-password
PASSWORD_RESET_MOBILE_URL=lunas://app/reset-password
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_TOKEN=
PASSWORD_RESET_DELIVERY_TIMEOUT_MS=10000

# ========================================
# AWS Storage Configuration
# ========================================
# Production evidence is private S3. The EC2 instance role supplies AWS
# credentials; do not set long-lived AWS access keys in this file.
STORAGE_PROVIDER=s3
AWS_REGION=ap-southeast-1
S3_EVIDENCE_BUCKET=lunas-evidence-production
S3_SERVER_SIDE_ENCRYPTION=AES256
EVIDENCE_SIGNED_URL_EXPIRE_SECONDS=3600

# Optional local S3-compatible endpoint, for example MinIO. Leave empty for
# AWS S3. This is not needed for the production EC2 deployment.
S3_ENDPOINT=

# Keep enabled only while historical Supabase objects are being migrated and
# verified. Disable it after the S3 cutover acceptance checks pass.
SUPABASE_MIGRATION_READ_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lunas-storage

# ========================================
# OneSignal Configuration
# ========================================
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key
ONESIGNAL_USER_AUTH_KEY=your_onesignal_user_auth_key

# ========================================
# Google Maps API (Optional)
# ========================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ========================================
# Database Configuration (Docker)
# ========================================
# MongoDB stays on the private Compose network. Use URL-safe, non-default
# credentials because Compose also places them in the backend connection URI.
MONGO_ROOT_USERNAME=replace_with_a_database_administrator
MONGO_ROOT_PASSWORD=replace_with_a_long_url_safe_database_password
MONGO_DATABASE=lunas_db

# Published web/API ports bind to loopback by default. Set the bind addresses
# to 0.0.0.0 only when an approved firewall or reverse proxy requires it.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=5000

# Optional development-only mongo-express profile.
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=lunas-local-admin
MONGO_EXPRESS_PASSWORD=replace_with_a_local_admin_password

# AI is advisory and may be disabled without changing the incident workflow.
AI_SERVICE_ENABLED=true
AI_EVIDENCE_ANALYSIS_ENABLED=true
# Evidence uploads fail closed if face/plate redaction is unavailable.
PRIVACY_REDACTION_ENABLED=true

# ========================================
# Notes
# ========================================
# 1. NEVER commit this file to version control
# 2. Generate distinct JWT, refresh, session, and registration MFA secrets
#    (minimum 32 characters; never reuse one secret for another purpose)
# 3. Keep migration-only Supabase service_role credentials secret
# 4. Keep OneSignal REST API key secret
# 5. For production, use environment-specific values
# 6. Replace the Turnstile dummy keys before production deployment
# 7. NEXT_PUBLIC_API_URL is browser-facing; the Compose-only LUNAS_API_URL is
#    intentionally set to http://backend:5000/api/v1 in docker-compose.yml

# SLA scheduler (Compose enables one in-process monitor by default).
# Set false for tests and every API replica except the designated scheduler.
SLA_AUTOMATION_ENABLED=true
# Cron minute step; integer 1-59, default 5 (use a divisor of 60 for uniform spacing).
SLA_POLL_INTERVAL_MINUTES=5
# Optional hosted AI SLA recommendations. Configure only on the backend host.
# Keep disabled until an API key, billing and a feasibility review are available.
SLA_AI_ENABLED=false
SLA_AI_FREE_TIER_CONFIRMED=false
GEMINI_API_KEY=
# No paid fallback provider.
SLA_AI_TIMEOUT_MS=45000
# Free-tier quota exhaustion leaves manual entry available.
# Store the key only in backend secrets.
